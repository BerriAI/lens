{
  "request": {
    "method": "POST",
    "path": "/auth/session",
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "token": "{{admin_token}}"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json",
      "set-cookie": "lens_session={{session_cookie}}; HttpOnly; Max-Age=28800; Path=/; SameSite=strict"
    },
    "body": {
      "user_id": "lens-admin",
      "user_role": "proxy_admin"
    }
  }
}
