{
  "request": {
    "method": "POST",
    "path": "/lens",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "context": "ok",
      "model": "x",
      "name": "x",
      "scope": {
        "all_teams": true
      }
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "input": {
            "all_teams": true
          },
          "loc": [
            "body",
            "scope"
          ],
          "msg": "Extra inputs are not permitted",
          "type": "extra_forbidden"
        }
      ]
    }
  }
}
