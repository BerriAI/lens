{
  "request": {
    "method": "POST",
    "path": "/lens/traces/findings",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "traces": [
        {
          "scope": "all",
          "trace_id": "trace"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "input": "all",
          "loc": [
            "body",
            "traces",
            0,
            "scope"
          ],
          "msg": "Extra inputs are not permitted",
          "type": "extra_forbidden"
        },
        {
          "ctx": {
            "actual_length": 0,
            "field_type": "Tuple",
            "min_length": 1
          },
          "input": [
            {
              "scope": "all",
              "trace_id": "trace"
            }
          ],
          "loc": [
            "body",
            "traces"
          ],
          "msg": "Tuple should have at least 1 item after validation, not 0",
          "type": "too_short"
        }
      ]
    }
  }
}
