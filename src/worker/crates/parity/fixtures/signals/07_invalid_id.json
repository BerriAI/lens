{
  "request": {
    "method": "PUT",
    "path": "/lens/signals",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "signals": [
        {
          "id": "Bad-id",
          "name": "Bad",
          "question": "Question?"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "ctx": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "input": "Bad-id",
          "loc": [
            "body",
            "signals",
            0,
            "id"
          ],
          "msg": "String should match pattern '^[a-z][a-z0-9_]{0,63}$'",
          "type": "string_pattern_mismatch"
        }
      ]
    }
  }
}
