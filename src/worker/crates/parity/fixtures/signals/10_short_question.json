{
  "request": {
    "method": "PUT",
    "path": "/lens/signals",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "signals": [
        {
          "id": "signal",
          "name": "Signal",
          "question": "x"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "ctx": {
            "min_length": 3
          },
          "input": "x",
          "loc": [
            "body",
            "signals",
            0,
            "question"
          ],
          "msg": "String should have at least 3 characters",
          "type": "string_too_short"
        }
      ]
    }
  }
}
