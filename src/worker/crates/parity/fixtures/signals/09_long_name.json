{
  "request": {
    "method": "PUT",
    "path": "/lens/signals",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "signals": [
        {
          "id": "signal",
          "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "question": "Question?"
        }
      ]
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "ctx": {
            "max_length": 60
          },
          "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
          "loc": [
            "body",
            "signals",
            0,
            "name"
          ],
          "msg": "String should have at most 60 characters",
          "type": "string_too_long"
        }
      ]
    }
  }
}
