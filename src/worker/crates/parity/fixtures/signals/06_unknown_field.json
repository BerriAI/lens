{
  "request": {
    "method": "PUT",
    "path": "/lens/signals",
    "headers": {
      "authorization": "Bearer {{admin_token}}",
      "content-type": "application/json"
    },
    "body": {
      "enabled": true
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "detail": [
        {
          "input": true,
          "loc": [
            "body",
            "enabled"
          ],
          "msg": "Extra inputs are not permitted",
          "type": "extra_forbidden"
        }
      ]
    }
  }
}
