{
  "request": {
    "method": "GET",
    "path": "/lens/datasets",
    "headers": {
      "authorization": "Bearer {{jwt.other_team_viewer}}",
      "content-type": "application/json"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": [
      {
        "agent_name": "parity agent",
        "case_count": 2,
        "id": "{{dataset_id}}",
        "name": "parity dataset",
        "revision": 1,
        "updated_at": "{{timestamp}}"
      }
    ]
  }
}
