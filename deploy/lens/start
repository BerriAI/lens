#!/usr/bin/env bash
set -euo pipefail
lens_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
lens_root="$(cd -- "$lens_dir/../.." && pwd)"
if [[ -z "${LENS_IMAGE:-}" ]]; then
  unset LENS_IMAGE
fi
lens_build=false
for lens_argument in "$@"; do
  case "$lens_argument" in
    --build) lens_build=true ;;
    *) printf '%s\n' "Usage: $0 [--build]" >&2; exit 2 ;;
  esac
done
docker info >/dev/null
docker compose version >/dev/null
lens_compose=(docker compose --project-directory "$lens_dir" --file "$lens_dir/compose.yaml")
build_source() {
  export LENS_IMAGE=lens:local
  docker build --file "$lens_root/deploy/runtime/Dockerfile" --tag "$LENS_IMAGE" "$lens_root"
}
select_image() {
  if [[ -n "${LENS_IMAGE:-}" ]]; then
    docker image inspect "$LENS_IMAGE" >/dev/null 2>&1 || docker pull "$LENS_IMAGE"
    return
  fi
  if [[ -f "$lens_dir/image" ]]; then
    export LENS_IMAGE="$(cat "$lens_dir/image")"
    docker image inspect "$LENS_IMAGE" >/dev/null 2>&1 || docker pull "$LENS_IMAGE"
    return
  fi
  if [[ "$lens_build" == true || -f "$lens_dir/.env" ]]; then
    build_source
    return
  fi
  lens_published="ghcr.io/berriai/lens:$(tr -d '[:space:]' < "$lens_root/VERSION")"
  if docker image inspect "$lens_published" >/dev/null 2>&1 || docker pull "$lens_published"; then
    export LENS_IMAGE="$lens_published"
    return
  fi
  printf '%s\n' "Could not pull $lens_published. Building Lens from this checkout instead." >&2
  build_source
}
prepare() {
  test ! -L "$lens_dir/.env"
  if [[ "$lens_build" == false && -z "${LENS_IMAGE:-}" && -f "$lens_dir/.env" ]] && \
      ! "${lens_compose[@]}" config --images lens | grep -Fxq 'lens:local'; then
    return
  fi
  select_image
  docker run --rm --user "$(id -u):$(id -g)" --volume "$lens_dir:/setup" "$LENS_IMAGE" init /setup
  if ! grep -q '^LENS_IMAGE=' "$lens_dir/.env"; then
    printf '\nLENS_IMAGE=%s\n' "$LENS_IMAGE" >> "$lens_dir/.env"
  fi
}
prepare
"${lens_compose[@]}" up --detach --wait --wait-timeout 180
lens_public_url="$("${lens_compose[@]}" exec -T lens sh -c 'printf "%s" "$LENS_PUBLIC_URL"')"
printf '%s\n' "Lens is ready at ${lens_public_url%/}/ui/" 'Sign in with LENS_ADMIN_TOKEN from deploy/lens/.env. Keep the file private and retain it across restarts.'
