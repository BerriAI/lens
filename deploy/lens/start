#!/usr/bin/env bash
set -euo pipefail
lens_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
lens_root="$(cd -- "$lens_dir/../.." && pwd)"
lens_build=false
for lens_argument in "$@"; do
  case "$lens_argument" in
    --build) lens_build=true ;;
    *) printf '%s\n' "Usage: $0 [--build]" >&2; exit 2 ;;
  esac
done
: "${LITELLM_PROXY_API_BASE:?Export the dedicated workspace gateway base}"
: "${LITELLM_PROXY_API_KEY:?Export the dedicated workspace gateway key}"
if [[ -n "${LENS_IMAGE:-}" && -z "${LENS_AGENTS_IMAGE:-}" || -z "${LENS_IMAGE:-}" && -n "${LENS_AGENTS_IMAGE:-}" ]]; then
  printf '%s\n' 'Set both LENS_IMAGE and LENS_AGENTS_IMAGE from the same source revision' >&2
  exit 2
fi
docker info >/dev/null
docker compose version >/dev/null
export LENS_IMAGE="${LENS_IMAGE:-lens:agent-first}"
export LENS_AGENTS_IMAGE="${LENS_AGENTS_IMAGE:-lens-agents:agent-first}"
if [[ "$lens_build" == true ]] || ! docker image inspect "$LENS_IMAGE" "$LENS_AGENTS_IMAGE" >/dev/null 2>&1; then
  if [[ "$lens_build" == false && ( "$LENS_IMAGE" != lens:agent-first || "$LENS_AGENTS_IMAGE" != lens-agents:agent-first ) ]]; then
    docker pull "$LENS_IMAGE"
    docker pull "$LENS_AGENTS_IMAGE"
  else
    docker build --file "$lens_root/deploy/runtime/Dockerfile" --target runtime --tag "$LENS_IMAGE" "$lens_root"
    docker build --file "$lens_root/deploy/runtime/Dockerfile" --target agents --tag "$LENS_AGENTS_IMAGE" "$lens_root"
  fi
fi
test ! -L "$lens_dir/.env"
docker compose --project-directory "$lens_dir" --file "$lens_dir/compose.yaml" up --detach --wait --wait-timeout 180
printf '%s\n' "Lens is ready at ${LENS_PUBLIC_URL:-http://localhost:4318}/ui/" 'Sign in with LENS_ADMIN_TOKEN from deploy/lens/.env. Keep it private and retain the state volumes across restarts.'
