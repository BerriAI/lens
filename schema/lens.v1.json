{
  "$defs": {
    "AgentIo": {
      "additionalProperties": false,
      "properties": {
        "completion": {
          "$ref": "#/$defs/Completion"
        },
        "connection": {
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
          "type": "string"
        },
        "input": {
          "items": {
            "$ref": "#/$defs/InputBinding"
          },
          "minItems": 1,
          "type": "array"
        },
        "output": {
          "$ref": "#/$defs/OutputMapping"
        },
        "submit": {
          "$ref": "#/$defs/AgentRequest"
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceMapping"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "const": 1,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "connection",
        "submit",
        "input",
        "completion",
        "output"
      ],
      "type": "object"
    },
    "AgentRequest": {
      "additionalProperties": false,
      "properties": {
        "accepted_status": {
          "format": "uint16",
          "maximum": 299,
          "minimum": 200,
          "type": "integer"
        },
        "json": {
          "additionalProperties": true,
          "type": "object"
        },
        "method": {
          "$ref": "#/$defs/SubmitMethod"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "path",
        "json",
        "accepted_status"
      ],
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ApiErrorCode"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "detail",
        "code"
      ],
      "type": "object"
    },
    "ApiErrorCode": {
      "enum": [
        "dataset_not_found",
        "revision_not_found",
        "run_not_found",
        "eval_not_found",
        "run_closed",
        "unknown_case",
        "contract_version",
        "unauthorized"
      ],
      "type": "string"
    },
    "CaseDiff": {
      "additionalProperties": false,
      "properties": {
        "baseline_url": {
          "type": "string"
        },
        "candidate_url": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "critical",
        "baseline_url",
        "candidate_url"
      ],
      "type": "object"
    },
    "CaseError": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "type": "object"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": null,
          "format": "double",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "duration_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "Completion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "immediate",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "ImmediateCompletion",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error_pointer": {
              "anyOf": [
                {
                  "$ref": "#/$defs/JsonPointer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "failure": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "id_pointer": {
              "$ref": "#/$defs/JsonPointer"
            },
            "interval_ms": {
              "format": "uint64",
              "maximum": 60000,
              "minimum": 250,
              "type": "integer"
            },
            "kind": {
              "const": "poll",
              "type": "string"
            },
            "path_template": {
              "type": "string"
            },
            "require_item": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RequiredItem"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status_pointer": {
              "$ref": "#/$defs/JsonPointer"
            },
            "success": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            "timeout_ms": {
              "format": "uint64",
              "maximum": 3600000,
              "minimum": 1000,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "id_pointer",
            "path_template",
            "status_pointer",
            "success",
            "failure",
            "interval_ms",
            "timeout_ms"
          ],
          "title": "PollCompletion",
          "type": "object"
        }
      ]
    },
    "CreateEvalRun": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "minLength": 1,
          "type": "string"
        },
        "agent_io": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentIo"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_run_id": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "minLength": 1,
          "type": "string"
        },
        "case_ids": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ci_url": {
          "default": "",
          "type": "string"
        },
        "dataset_id": {
          "type": "string"
        },
        "eval": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/Gate",
          "default": {
            "cost_per_case": null,
            "critical": 0,
            "min": {},
            "pass_rate": null,
            "regressions": 0
          }
        },
        "pr": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "scorers": {
          "items": {
            "$ref": "#/$defs/Scorer"
          },
          "minItems": 1,
          "type": "array"
        },
        "timeout_per_trial_ms": {
          "default": 1200000,
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "trials": {
          "default": 1,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "eval",
        "agent",
        "dataset_id",
        "revision",
        "version",
        "branch",
        "scorers"
      ],
      "type": "object"
    },
    "EvalDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/EvalSpec"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "spec",
        "updated_at"
      ],
      "type": "object"
    },
    "EvalRun": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "ci_url": {
          "default": "",
          "type": "string"
        },
        "eval": {
          "type": "string"
        },
        "expected_trials": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "default": "",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "pr": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "received_trials": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/Summary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "eval",
        "agent",
        "version",
        "branch",
        "url",
        "expected_trials",
        "received_trials"
      ],
      "type": "object"
    },
    "EvalSpec": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "minLength": 1,
          "type": "string"
        },
        "agent_io": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentIo"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "default": "main",
          "minLength": 1,
          "type": "string"
        },
        "dataset_id": {
          "minLength": 1,
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/Gate",
          "default": {
            "cost_per_case": null,
            "critical": 0,
            "min": {},
            "pass_rate": null,
            "regressions": 0
          }
        },
        "revision": {
          "default": null,
          "format": "uint64",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "scorers": {
          "items": {
            "$ref": "#/$defs/Scorer"
          },
          "minItems": 1,
          "type": "array"
        },
        "timeout_per_trial_ms": {
          "default": 1200000,
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "trials": {
          "default": 1,
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "dataset_id",
        "scorers"
      ],
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "properties": {
        "cost_per_case": {
          "default": null,
          "format": "double",
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "critical": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "min": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "default": {},
          "type": "object"
        },
        "pass_rate": {
          "default": null,
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": [
            "number",
            "null"
          ]
        },
        "regressions": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "passed"
      ],
      "type": "object"
    },
    "InputBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/InputSource"
        },
        "target": {
          "$ref": "#/$defs/JsonPointer"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "type": "object"
    },
    "InputSource": {
      "enum": [
        "case.input",
        "case.followups",
        "trial.request_id"
      ],
      "type": "string"
    },
    "JsonPointer": {
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "OutputMapping": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "require_nonempty": {
          "type": "boolean"
        }
      },
      "required": [
        "pointer",
        "require_nonempty"
      ],
      "type": "object"
    },
    "RequiredItem": {
      "additionalProperties": false,
      "properties": {
        "array_pointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "matches": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "type": "object"
        }
      },
      "required": [
        "array_pointer",
        "matches"
      ],
      "type": "object"
    },
    "ResolvedDataset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "revision"
      ],
      "type": "object"
    },
    "RunCase": {
      "additionalProperties": false,
      "description": "One case of a run with the tool steps each trial took, for side-by-side comparison in the Runs UI",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/TrialSteps"
          },
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "title",
        "critical",
        "trials"
      ],
      "type": "object"
    },
    "RunCaseSummary": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "critical": {
          "type": "boolean"
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "critical"
      ],
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "running",
        "scoring",
        "done",
        "failed"
      ],
      "type": "string"
    },
    "Scorer": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "task_completed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "title": "TaskCompleted",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "first": {
              "minLength": 1,
              "type": "string"
            },
            "kind": {
              "const": "called_before",
              "type": "string"
            },
            "then": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "first",
            "then"
          ],
          "title": "CalledBefore",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "judge",
              "type": "string"
            },
            "model": {
              "default": "",
              "type": "string"
            },
            "prompt": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "prompt"
          ],
          "title": "Judge",
          "type": "object"
        }
      ]
    },
    "ScorerCheck": {
      "additionalProperties": false,
      "description": "A deterministic scorer re-run against one trial's trace, so the UI can say which rule failed",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "scorer": {
          "type": "string"
        }
      },
      "required": [
        "scorer",
        "passed"
      ],
      "type": "object"
    },
    "SubmitMethod": {
      "enum": [
        "POST"
      ],
      "type": "string"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "baseline_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_per_case": {
          "format": "double",
          "type": "number"
        },
        "errors": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fixed": {
          "items": {
            "$ref": "#/$defs/CaseDiff"
          },
          "type": "array"
        },
        "gate": {
          "$ref": "#/$defs/GateResult"
        },
        "pass_rate": {
          "format": "double",
          "type": "number"
        },
        "passed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "regressions": {
          "items": {
            "$ref": "#/$defs/CaseDiff"
          },
          "type": "array"
        },
        "scores": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "type": "object"
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "total",
        "pass_rate",
        "cost_per_case",
        "scores",
        "errors",
        "regressions",
        "fixed",
        "gate"
      ],
      "type": "object"
    },
    "ToolStep": {
      "additionalProperties": false,
      "properties": {
        "end_ns": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "start_ns": {
          "format": "int64",
          "type": "integer"
        },
        "tool_name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "tool_name",
        "ok",
        "start_ns",
        "end_ns"
      ],
      "type": "object"
    },
    "TraceAttribute": {
      "enum": [
        "session.id",
        "trace_id"
      ],
      "type": "string"
    },
    "TraceMapping": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "$ref": "#/$defs/TraceAttribute"
        },
        "pointer": {
          "$ref": "#/$defs/JsonPointer"
        },
        "source": {
          "$ref": "#/$defs/TraceSource"
        }
      },
      "required": [
        "source",
        "attribute",
        "pointer"
      ],
      "type": "object"
    },
    "TraceRef": {
      "additionalProperties": false,
      "properties": {
        "attribute": {
          "$ref": "#/$defs/TraceAttribute",
          "default": "session.id"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "TraceSource": {
      "enum": [
        "accepted",
        "completed"
      ],
      "type": "string"
    },
    "TrialSteps": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/ScorerCheck"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/ToolStep"
          },
          "type": "array"
        },
        "traces": {
          "items": {
            "$ref": "#/$defs/TrialTrace"
          },
          "type": "array"
        },
        "trial": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "trial",
        "checks",
        "steps"
      ],
      "type": "object"
    },
    "TrialTrace": {
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "trace_ref": {
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "trace_ref"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LensEvalContract",
  "type": "object"
}
