  "behavior": {
    "startup": "Lens always requires its own administrator credential and ClickHouse store. LITELLM_URL no longer selects a gateway-owned backend. LENS_MODE=gateway is rejected; omitted mode and explicit standalone remain supported",
    "worker": "Investigations execute through LocalControl and the typed JobBackend interface. Production remote claim polling, per-job gateway transport, and worker release coupling are removed",
    "credentials": "Lens owns tracing keys. The gateway retains scoped internal reads, spend and feedback through its separate service credential; remote credential refresh and credential-push routes are removed",
    "optional_gateway": "Configured analysis models and eval judges retain the optional explicit gateway URL and signed marker. Generic eval HTTP transport remains bounded and does not expose provider error bodies",
    "regressions": "Existing pipeline and evidence assertions run through a test-only HTTP replay implementation of JobBackend; only retired remote-claim and credential-push tests were removed"
  },
