@@ -0,0 +1,35 @@
+"use client";
+
+import type { ComponentProps } from "react";
+import {
+  configureLensHttp,
+  LensHostProvider,
+  LensWorkspace,
+  type LensHost,
+  type LensHttpConfig,
+} from "@litellm/lens-ui";
+import { LogDetailsDrawer } from "@/components/logs/detail";
+import { getGlobalLitellmHeaderName, getProxyBaseUrl, handleError, uiSpendLogsCall } from "@/components/networking";
+import { getAuthToken } from "@/lib/http/runtime";
+import { serverRootPath } from "@/lib/serverRootPath";
+
+const host: LensHost = {
+  spendLogs: { lookup: uiSpendLogsCall, Drawer: LogDetailsDrawer },
+};
+
+const httpConfig: LensHttpConfig = {
+  getBaseUrl: getProxyBaseUrl,
+  getAuthToken,
+  getAuthHeaderName: getGlobalLitellmHeaderName,
+  onError: handleError,
+  getServerRootPath: () => serverRootPath,
+};
+configureLensHttp(httpConfig);
+
+export function EmbeddedLens(props: ComponentProps<typeof LensWorkspace>) {
+  return (
+    <LensHostProvider host={host}>
+      <LensWorkspace {...props} />
+    </LensHostProvider>
+  );
+}
diff --git a/ui/litellm-dashboard/src/components/lens/EmbeddedLens.test.tsx b/ui/litellm-dashboard/src/components/lens/EmbeddedLens.test.tsx
new file mode 100644
index 0000000000..65ecd828b1
--- /dev/null
+++ b/ui/litellm-dashboard/src/components/lens/EmbeddedLens.test.tsx
@@ -0,0 +1,115 @@
+import { render, screen } from "@testing-library/react";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type { ReactNode } from "react";
+import type { LensHost, LensHttpConfig, SpendLogDrawerProps } from "@litellm/lens-ui";
+import { setServerRootPath } from "@/lib/serverRootPath";
+import { EmbeddedLens } from "./EmbeddedLens";
+
+const { configure, workspace, provider, lookup, drawer, baseUrl, headerName, token, onError } = vi.hoisted(() => ({
+  configure: vi.fn<(config: LensHttpConfig) => void>(),
+  workspace: vi.fn(),
+  provider: vi.fn<(host: LensHost) => void>(),
+  lookup: vi.fn(),
+  drawer: vi.fn(),
+  baseUrl: vi.fn<() => string>(),
+  headerName: vi.fn<() => string>(),
+  token: vi.fn<() => string | null>(),
+  onError: vi.fn(),
+}));
+
+vi.mock("@litellm/lens-ui", () => ({
+  configureLensHttp: configure,
+  LensHostProvider: ({ host, children }: { host: LensHost; children: ReactNode }) => {
+    provider(host);
+    return children;
+  },
+  LensWorkspace: (props: { accessToken: string; userRole: string; readOnly: boolean }) => {
+    workspace(props);
+    return <div>Shared Lens workspace</div>;
+  },
+}));
+
+vi.mock("@/components/logs/detail", () => ({
+  LogDetailsDrawer: (props: SpendLogDrawerProps) => {
+    drawer(props);
+    return props.open ? <div>Gateway spend details</div> : null;
+  },
+}));
+vi.mock("@/components/networking", () => ({
+  getProxyBaseUrl: baseUrl,
+  getGlobalLitellmHeaderName: headerName,
+  handleError: onError,
+  uiSpendLogsCall: lookup,
+}));
+vi.mock("@/lib/http/runtime", () => ({ getAuthToken: token }));
+
+const session = { accessToken: "session-token", userRole: "proxy_admin_viewer", readOnly: true };
+const config = configure.mock.calls[0][0];
+
+describe("embedded Lens", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    setServerRootPath("/");
+    baseUrl.mockReturnValue("https://gateway.example/prefix");
+    headerName.mockReturnValue("X-Gateway-Key");
+    token.mockReturnValue("session-token");
+  });
+
+  it("uses the gateway's live HTTP configuration and error handler", () => {
+    render(<EmbeddedLens {...session} />);
+    expect(screen.getByText("Shared Lens workspace")).toBeVisible();
+    expect(config.getBaseUrl()).toBe("https://gateway.example/prefix");
+    expect(config.getAuthHeaderName?.()).toBe("X-Gateway-Key");
+    expect(config.getAuthToken()).toBe("session-token");
+
+    token.mockReturnValue("refreshed-token");
+    baseUrl.mockReturnValue("https://worker.example");
+    headerName.mockReturnValue("Authorization");
+    expect(config.getAuthToken()).toBe("refreshed-token");
+    expect(config.getBaseUrl()).toBe("https://worker.example");
+    expect(config.getAuthHeaderName?.()).toBe("Authorization");
+    token.mockReturnValue(null);
+    expect(config.getAuthToken()).toBeNull();
+    config.onError?.("Request rejected");
+    expect(onError).toHaveBeenCalledWith("Request rejected");
+  });
+
+  it("uses the current mount prefix and retains session permissions", () => {
+    setServerRootPath("/gateway");
+    render(<EmbeddedLens {...session} />);
+    expect(workspace).toHaveBeenLastCalledWith(session);
+    expect(config.getServerRootPath?.()).toBe("/gateway");
+
+    setServerRootPath("/nested/gateway");
+    expect(config.getServerRootPath?.()).toBe("/nested/gateway");
+  });
+
+  it("delegates the spend-log lookup and drawer to the gateway", async () => {
+    lookup.mockResolvedValue({ data: [] });
+    render(<EmbeddedLens {...session} />);
+    const spendLogs = provider.mock.calls[0][0].spendLogs;
+    if (!spendLogs) throw new Error("Missing gateway spend-log integration");
+    const query = {
+      accessToken: "session-token",
+      start_date: "2026-10-08T10:00:00Z",
+      end_date: "2026-10-08T10:30:00Z",
+      page: 1,
+      page_size: 1,
+      params: { request_id: "request/with:a-specific-id" },
+    };
+    expect(await spendLogs.lookup(query)).toEqual({ data: [] });
+    expect(lookup).toHaveBeenCalledWith(query);
+
+    const props = {
+      open: true,
+      onClose: vi.fn(),
+      logEntry: null,
+      accessToken: "session-token",
+      backTo: { label: "Lens trace", icon: <span>Trace</span> },
+    };
+    const Drawer = spendLogs.Drawer;
+    render(<Drawer {...props} />);
+    expect(screen.getByText("Gateway spend details")).toBeVisible();
+    expect(drawer).toHaveBeenCalledWith(props);
+  });
+});
